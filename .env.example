###############################################################################
# Asked. — environment template
#
# Copy to `.env` and run `php artisan key:generate`.
# For production deployment to Dokploy + Nixpacks, see PRODUCTION_ENV.md.
###############################################################################

# ───────────────────────────────────────────────────────────────────────────
# 1. App & runtime
# ───────────────────────────────────────────────────────────────────────────
APP_NAME="Asked."
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

VITE_APP_NAME="Asked."

# UI locale — supported values: en, fr (see lang/{en,fr}/*.php)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ───────────────────────────────────────────────────────────────────────────
# 2. Logs
# ───────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ───────────────────────────────────────────────────────────────────────────
# 3. Reverse proxy + session
# ───────────────────────────────────────────────────────────────────────────
# Behind a load balancer / reverse proxy in production?
# Set to "*" to trust all proxies, or a comma-separated list of IPs.
# TRUSTED_PROXIES=*

# Force secure cookies in production (set to true behind HTTPS)
# SESSION_SECURE_COOKIE=true

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax

# ───────────────────────────────────────────────────────────────────────────
# 4. Database — SQLite by default (file created by `composer run setup`)
# ───────────────────────────────────────────────────────────────────────────
DB_CONNECTION=sqlite

# For Postgres in production, uncomment and fill below:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=asked
# DB_USERNAME=asked
# DB_PASSWORD=

# Or MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=asked
# DB_USERNAME=root
# DB_PASSWORD=

# ───────────────────────────────────────────────────────────────────────────
# 5. Cache & queue
# ───────────────────────────────────────────────────────────────────────────
CACHE_STORE=database
# CACHE_PREFIX=
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# ───────────────────────────────────────────────────────────────────────────
# 6. Mail — used for team invitations, password reset, email verification
# ───────────────────────────────────────────────────────────────────────────
# Local default = log (writes to storage/logs/laravel.log).
# In production, switch to smtp/ses/postmark/etc. and fill in credentials.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ───────────────────────────────────────────────────────────────────────────
# 7. Auth (Fortify) — defaults are usually fine
# ───────────────────────────────────────────────────────────────────────────
# FORTIFY_GUARD=web
# FORTIFY_PASSWORDS=users

# ───────────────────────────────────────────────────────────────────────────
# 8. Runtime + maintenance
# ───────────────────────────────────────────────────────────────────────────
APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12
# PHP_CLI_SERVER_WORKERS=4

# ───────────────────────────────────────────────────────────────────────────
# 9. Optional — Memcached, Redis, S3-compatible storage
# ───────────────────────────────────────────────────────────────────────────
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Persistent connections look attractive (saves TCP+AUTH per request)
# but break under PHP-FPM at load: workers cycle every pm.max_requests
# and phpredis leaks/recreates persistent handles on each cycle. We
# measured 100 VUs going from p95=58s with persistent=true to
# p95=229ms with persistent=false. Keep this off.
REDIS_PERSISTENT=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
